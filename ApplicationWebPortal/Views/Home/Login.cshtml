@{
    ViewBag.Title = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h2 class="text-center mb-4">Login Portal</h2>

            <!-- Admin/HR Login Form -->
            <form method="post" asp-controller="Home" asp-action="Login">
                <div class="form-group mb-3">
                    <label>Username (for Admin/HR)</label>
                    <input type="text" name="Username" class="form-control form-control-sm" required />
                </div>

                <div class="form-group mb-3">
                    <label>Password (for Admin/HR)</label>
                    <input type="password" name="Password" class="form-control form-control-sm" required />
                </div>

                <div class="form-group mb-3">
                    <label>Role</label>
                    <select name="role" class="form-control form-control-sm" required>
                        <option value="Admin">Admin</option>
                        <option value="HR">HR</option>
                    </select>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-sm">Login</button>
                </div>
            </form>

            <hr />

            <!-- Candidate Login Button -->
            <form method="post" asp-controller="Home" asp-action="Login">
                <input type="hidden" name="role" value="Candidate" />
                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-sm">Login as Candidate</button>
                </div>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">@ViewBag.Error</div>
            }
        </div>
    </div>
</div>
